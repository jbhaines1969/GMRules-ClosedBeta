# GMRules closed-beta service settings.
# Copy to .env on the server and edit values there.

# Web bind settings.
# Use 127.0.0.1 when a reverse proxy handles public traffic.
# Use 0.0.0.0 only when the Java service should listen directly on all interfaces.
GMRULES_WEB_HOST=127.0.0.1
GMRULES_WEB_PORT=8080
GMRULES_WEB_THREADS=12
GMRULES_WEB_MAXUPLOADBYTES=536870912
GMRULES_WEB_SESSIONMINUTES=480
# Keep false in production. When true, GMRules skips login and creates a
# local development session. Startup also requires a loopback host, local HTTP
# public URL, and draft/account paths under .local-dev.
GMRULES_WEB_LOCALMODE=false
# Local-mode launcher only. Production must leave this blank.
GMRULES_WEB_LOCALACCESSKEYFILE=

# Public URL used in email verification links.
GMRULES_WEB_PUBLICBASEURL=https://gmrules.com

# Persistent server-side data.
GMRULES_WEB_DRAFTSDIR=drafts
GMRULES_WEB_ACCOUNTSFILE=server-data/accounts.properties
GMRULES_WEB_NDAAUDITDIR=server-data/nda-audit
GMRULES_WEB_FEEDBACKDIR=server-data/feedback

# Comma-separated account emails allowed to use /api/admin and the in-app admin panel.
GMRULES_WEB_ADMINEMAILS=
GMRULES_WEB_BLOCKEDACCESSFILE=server-data/blocked-access.properties
GMRULES_WEB_REQUESTLOGDIR=server-data/request-logs

# Resend email delivery.
GMRULES_EMAIL_API_URL=https://api.resend.com/emails
GMRULES_EMAIL_API_KEY=
GMRULES_EMAIL_FROM=GMRules <beta@gmrules.com>

# Optional copy of finalized NDA audit CSVs.
GMRULES_NDAAUDIT_EMAILTO=

# Discord feedback delivery.
# Add real webhook URLs to the production .env only.
GMRULES_DISCORD_FEEDBACKWEBHOOKURL=
GMRULES_DISCORD_BUGWEBHOOKURL=
GMRULES_DISCORD_BLOCKERWEBHOOKURL=
